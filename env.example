# ===========================================
# SPERM RACE - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# General
# ===========================================
NODE_ENV=development

# ===========================================
# Backend (NestJS)
# ===========================================
API_PORT=4000
API_HOST=localhost

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sperm_race

# Redis (for game state and pub/sub)
REDIS_URL=redis://localhost:6379

# JWT Secret (for future auth if needed)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===========================================
# Solana
# ===========================================
# Network: mainnet-beta, devnet, testnet, localnet
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ID (update after deploying smart contract)
PROGRAM_ID=EPLZGLkPntoQswDdtDdgZ3kK1jrQBJC66dgadtyeDEry

# Backend wallet (for distribution transactions)
# WARNING: Keep this secret! Use a dedicated wallet with limited funds
BACKEND_WALLET_PRIVATE_KEY=

# ===========================================
# Frontend (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=EPLZGLkPntoQswDdtDdgZ3kK1jrQBJC66dgadtyeDEry

# ===========================================
# Game Configuration
# ===========================================
# Phase durations in milliseconds
PREPARATION_DURATION_MS=60000
RESOLUTION_DURATION_MS=20000
DISTRIBUTION_DURATION_MS=30000

# House fee percentage (e.g., 15 = 15%)
HOUSE_FEE_PERCENT=15

# Number of sperms in the race
SPERM_COUNT=10

# Bet limits in lamports (1 SOL = 1,000,000,000 lamports)
MIN_BET_LAMPORTS=10000000
MAX_BET_LAMPORTS=10000000000
