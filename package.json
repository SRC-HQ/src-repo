{
  "name": "sperm-race",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "yarn workspace @sperm-race/api dev",
    "dev:web": "yarn workspace @sperm-race/web dev",
    "build": "turbo build",
    "build:api": "yarn workspace @sperm-race/api build",
    "build:web": "yarn workspace @sperm-race/web build",
    "start:api": "yarn workspace @sperm-race/api start:prod",
    "start:web": "yarn workspace @sperm-race/web start",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build:contracts": "cd packages/contracts && anchor build && cd ../.. && ./scripts/copy-contract-types.sh",
    "generate:idl": "yarn build:contracts && yarn workspace @sperm-race/anchor-client generate",
    "db:migrate": "yarn workspace @sperm-race/api db:migrate",
    "db:seed": "yarn workspace @sperm-race/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  }
}
