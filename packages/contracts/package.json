{
  "name": "@sperm-race/contracts",
  "main": "target/types/sperm_race.ts",
  "types": "target/types/sperm_race.ts",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./target/types/sperm_race.ts",
    "./idl": "./target/idl/sperm_race.json"
  },
  "scripts": {
    "prebuild": "mkdir -p target/deploy && cp keys/program.json target/deploy/sperm_race-keypair.json 2>/dev/null || true",
    "build": "anchor build",
    "test": "bun run prebuild && anchor test",
    "test:local": "bun run prebuild && anchor test --skip-local-validator",
    "deploy:devnet": "bun run prebuild && anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "bun run prebuild && anchor deploy --provider.cluster mainnet",
    "clean": "rm -rf target",
    "generate-keys": "bun run scripts/generate-keys.ts",
    "fund-devnet": "bun run scripts/fund-devnet.ts",
    "poc": "bun run generate-keys && bun run test",
    "poc:devnet": "bun run scripts/poc-betting.ts",
    "backup-program-key": "cp target/deploy/sperm_race-keypair.json keys/program.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.9",
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.2"
  }
}
